rules_version = '2';

// A Classic Match: Firestore security rules.
// Each reader can read and write only their own document, users/{their uid}.
// Everything else is locked. Cloud Functions use the admin SDK, which skips these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
